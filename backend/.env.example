# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
MINI_APP_URL=https://your-frontend.vercel.app

# --- Supabase -----------------------------------------------------------------
# Use the SERVICE ROLE key here, never the anon key. This key bypasses RLS
# and must only ever live on the backend (Railway env vars), never in the
# frontend or in git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server -------------------------------------------------------------------
PORT=3000
# Set this to your exact Vercel URL in production, e.g. https://bingo.vercel.app
# Using * is fine for local development only.
CORS_ORIGIN=*

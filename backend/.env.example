# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Railway public URL (no trailing slash)
PUBLIC_URL=https://your-app.up.railway.app

# Vercel frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Admin login for the dashboard
ADMIN_PASSWORD=choose_a_strong_password
JWT_SECRET=long_random_string_for_signing_admin_sessions

# Secret used to verify Telegram webhook calls
WEBHOOK_SECRET=another_long_random_string

# Game store: payment check via verify.et (set the real key in Railway, never commit it)
CHECK_API_KEY=VERIFY_BANK_ET_your_key_here
# Optional, defaults to https://verify.et
CHECK_API_URL=https://verify.et
# Optional: Telegram IDs (comma separated) that get a ping on new paid orders
STORE_ADMIN_TELEGRAM_IDS=

# Server
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://mmy-1c4m.vercel.app

# Database - Supabase Postgres
# In Supabase: Project Settings -> Database -> Connection string -> "Connection pooling"
# (use the pooled/6543 URI for a long-running server like Railway; the
# direct/5432 URI also works but pooling is recommended)
DATABASE_URL=postgresql://postgres.udohnelsljaprlwqjose:yuuuuueyebehe@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Auth
JWT_SECRET=b+rTwejKHjabs2QhvWBksZmXK73ntVvPocKyPd5RKRhTfl8JcBE7s2EIFp0yKrY177S3eQG2KyULfgwHCoznoA==
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Seed admin (used only by scripts/createAdmin.js)
SEED_ADMIN_USERNAME=Gutu
SEED_ADMIN_EMAIL=gutubekele81@gmail.com
SEED_ADMIN_PASSWORD=Gutuuuu12

# Railway terminates TLS for you - trust its proxy so req.ip / rate limiting work correctly
TRUST_PROXY=1

# Telegram bot (optional - the bot is disabled if either is missing)
# Get TELEGRAM_BOT_TOKEN from @BotFather. TELEGRAM_BOT_SHARED_SECRET is a
# separate random secret YOU generate (NOT the bot token) - used to sign
# requests between the bot and POST /api/auth/telegram-register.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_BOT_SHARED_SECRET=generate-a-long-random-string-here
# This backend's own public URL - the bot calls telegram-register on
# itself through this. Defaults to http://localhost:PORT if unset, which
# is correct for local dev; set this to your real Railway URL in prod.
SELF_API_URL=https://your-backend.up.railway.app
# Required channel/group (usernames only, no @) - the bot must be an
# admin in both for membership checks to work. Defaults match Buna
# Games' actual channel/group if left unset.
TELEGRAM_REQUIRED_CHANNEL=buna_gam
TELEGRAM_REQUIRED_GROUP=bunagames_meber
